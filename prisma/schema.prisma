generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  hobby
  pro
  elite
  admin
  banned
}

enum PermissionAction {
  create
  read
  update
  delete
  manage
}

enum PermissionResource {
  project
  page
  component
  user
  blog
  doc
  roadmap
  deployment
  settings
  analytics
}

enum AuditAction {
  user_login
  user_logout
  user_register
  user_banned
  user_unbanned
  role_changed
  permission_granted
  permission_revoked
  project_created
  project_deleted
  content_flagged
  content_approved
  content_rejected
  settings_changed
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?   @db.Text
  password          String?
  role              Role      @default(hobby)
  username          String?   @unique
  profilePictureId  String?
  isBanned          Boolean   @default(false)
  banReason         String?   @db.Text
  bannedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  lastLoginIp       String?

  accounts          Account[]
  sessions          Session[]
  projects          Project[]
  components        Component[]
  blogPosts         BlogPost[]
  docPages          DocPage[]
  roadmapItems      RoadmapItem[]
  pageCollaborators PageCollaborator[]
  pageComments      PageComment[]
  commentThreads    PageCommentThread[]
  userPermissions   UserPermission[]
  loginHistory      LoginHistory[]
  auditLogs         AuditLog[]
  flaggedContent    FlaggedContent[]
  moderationActions ModerationAction[]

  @@map("users")
  @@index([email])
  @@index([isBanned])
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verifications")
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String
  userAgent  String?  @db.Text
  success    Boolean
  failReason String?  @db.Text
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_history")
}

model RolePermission {
  id         String             @id @default(cuid())
  role       Role
  resource   PermissionResource
  action     PermissionAction
  createdAt  DateTime           @default(now())

  @@unique([role, resource, action])
  @@index([role])
  @@map("role_permissions")
}

model UserPermission {
  id         String             @id @default(cuid())
  userId     String
  resource   PermissionResource
  action     PermissionAction
  allowed    Boolean            @default(true)
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action])
  @@index([userId])
  @@map("user_permissions")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  resource    String?
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?     @db.Text
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model FlaggedContent {
  id          String   @id @default(cuid())
  contentType String
  contentId   String
  reason      String   @db.Text
  reportedBy  String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation(fields: [reportedBy], references: [id], onDelete: Cascade)
  moderationActions ModerationAction[]

  @@index([status])
  @@index([contentType, contentId])
  @@index([reportedBy])
  @@map("flagged_content")
}

model ModerationAction {
  id              String   @id @default(cuid())
  flaggedContentId String
  moderatorId     String
  action          String
  reason          String?  @db.Text
  createdAt       DateTime @default(now())

  flaggedContent FlaggedContent @relation(fields: [flaggedContentId], references: [id], onDelete: Cascade)
  moderator      User           @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([flaggedContentId])
  @@index([moderatorId])
  @@map("moderation_actions")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  userId        String
  subdomain     String?  @unique
  customDomain  String?  @unique
  isPublished   Boolean  @default(false)
  customThemes  Json?    @default("[]")
  cssVariables  Json?    @default("[]")
  spacingScale  Json?    @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages       Page[]
  envVars     EnvironmentVariable[]
  deployments Deployment[]
  components  Component[]

  @@index([userId])
  @@map("projects")
}

model Page {
  id        String   @id @default(cuid())
  projectId String
  name      String
  slug      String
  content   String   @db.LongText
  code      String?  @db.LongText
  isHome    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collaborators     PageCollaborator[]
  comments          PageComment[]
  sections          PageSection[]
  previewLinks      PagePreviewLink[]
  
  @@unique([projectId, slug])
  @@index([projectId])
  @@map("pages")
}

model EnvironmentVariable {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, key])
  @@index([projectId])
  @@map("environment_variables")
}

model Deployment {
  id          String   @id @default(cuid())
  projectId   String
  status      String
  containerId String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
  @@map("deployments")
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  status                 String   @default("free")
  plan                   String   @default("free")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  @@index([userId])
  @@map("subscriptions")
}

model Component {
  id             String   @id @default(cuid())
  name           String
  type           String
  category       String?
  icon           String?
  defaultContent Json?
  defaultStyle   Json?
  componentCode  String?  @db.LongText
  isBuiltin      Boolean  @default(false)
  userId         String?
  projectId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       ComponentVersion[]

  @@index([userId])
  @@index([projectId])
  @@map("components")
}

model ComponentVersion {
  id          String   @id @default(cuid())
  componentId String
  version     Int
  content     Json?
  style       Json?
  code        String?  @db.LongText
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, version])
  @@index([componentId])
  @@map("component_versions")
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?  @db.LongText
  content      String   @db.LongText
  published    Boolean  @default(false)
  authorId     String?
  contributorIds Json?  @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([published])
  @@index([authorId])
  @@map("blog_posts")
}

model DocPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.LongText
  published Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([published])
  @@index([authorId])
  @@map("doc_pages")
}

enum RoadmapStatus {
  planned
  in_progress
  completed
  cancelled
}

model RoadmapItem {
  id          String        @id @default(cuid())
  title       String
  description String         @db.LongText
  status      RoadmapStatus  @default(planned)
  order       Int           @default(0)
  eta         String?
  slug        String?       @unique
  authorId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([order])
  @@index([authorId])
  @@map("roadmap_items")
}

enum CollaboratorRole {
  viewer
  editor
  admin
}

model PageCollaborator {
  id        String            @id @default(cuid())
  pageId    String
  userId    String
  role      CollaboratorRole  @default(viewer)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
  @@map("page_collaborators")
}

model PageComment {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  elementId String?
  content   String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page    Page                @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads PageCommentThread[]

  @@index([pageId])
  @@index([userId])
  @@index([elementId])
  @@map("page_comments")
}

model PageCommentThread {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  comment PageComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([userId])
  @@map("page_comment_threads")
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  elementId String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, elementId])
  @@index([pageId])
  @@index([elementId])
  @@map("page_sections")
}

model PagePreviewLink {
  id          String    @id @default(cuid())
  pageId      String
  token       String    @unique
  password    String?   @db.Text
  expiresAt   DateTime?
  accessCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([token])
  @@map("page_preview_links")
}
